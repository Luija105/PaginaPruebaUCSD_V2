@using PaginaPruebaUCSD_V2.Models
@using PaginaPruebaUCSD_V2.Services
@inject IStudentService StudentService
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService
@inject IJSRuntime JS

<div class="login-shell">
    <!-- Panel de marca (Izquierda) -->
    <div class="login-brand">
        <div class="brand-logo">
            <div class="logo-image-container">
                <img src="https://www.ucsd.edu.do/wp-content/uploads/2024/01/cropped-PHOTO-2023-12-21-15-00-32-1-768x768.png" 
                     alt="logoUCSD" 
                     width="100" />
            </div>
            <span class="logo-name">Universidad Católica de Santo Domingo</span>
        </div>

        <div class="brand-body">
            <h1 class="brand-title">Portal de Servicios<br />Estudiantiles</h1>
            <p class="brand-sub">
                Accede a tu historial académico, gestiona tu matrícula,
                consulta tus finanzas y más, todo en un solo lugar.
            </p>

            <!-- Carrusel automático -->
            <div id="carouselExampleSlidesOnly" 
                 class="carousel slide" 
                 data-bs-ride="carousel" 
                 data-bs-interval="2000" 
                 data-bs-pause="hover"
                 data-bs-touch="false">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="https://www.ucsd.edu.do/wp-content/uploads/2025/05/Arte-informativo-Direccion-de-Tecnologia-Educativa_WEB-2.png" 
                             class="d-block w-100" 
                             alt="Anuncio Dirección de Tecnología" />
                    </div>
                    <div class="carousel-item">
                        <img src="sample-data/Calendario-Grado.png" 
                             class="d-block w-100" 
                             alt="Calendario Grado" />
                    </div>
                    <div class="carousel-item">
                        <img src="sample-data/Calendario-PosGrado.png" 
                             class="d-block w-100" 
                             alt="Calendario Posgrado" />
                    </div>
                </div>
            </div>
        </div>

        <p class="brand-footer">© @DateTime.Now.Year Universidad Católica de Santo Domingo. Todos los derechos reservados.</p>
    </div>

    <!-- Panel de formulario (Derecha) -->
    <div class="login-form-panel">
        <div class="login-card">
            <h2 class="form-title">Iniciar Sesión</h2>
            <p class="form-sub">Ingresa tu matrícula y contraseña para acceder</p>

            <EditForm Model="_creds" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="field">
                    <label>Matrícula</label>
                    <InputText @bind-Value="_creds.Matricula" placeholder="Ej. 20210423" class="input mono" />
                </div>

                <div class="field">
                    <label>Contraseña</label>
                    <InputText type="password" @bind-Value="_creds.Password" placeholder="•••••••••••" class="input" />
                </div>

                @if (_error is not null)
                {
                    <div class="alert-error">@_error</div>
                }

                <button type="submit" class="btn-primary" disabled="@_loading">
                    @(_loading ? "Verificando..." : "Entrar al Portal")
                </button>
            </EditForm>

            <div class="demo-hint">
                Demo: matrícula <code>1234</code> / contraseña <code>1234</code>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<Student> OnSuccess { get; set; }

    private readonly AuthCredentials _creds = new();
    private bool _loading;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Inicializa el carrusel de Bootstrap mediante JSInterop
            await JS.InvokeVoidAsync("eval", @"
                const el = document.getElementById('carouselExampleSlidesOnly');
                if (el && typeof bootstrap !== 'undefined') {
                    new bootstrap.Carousel(el, {
                        interval: 2000,
                        ride: 'carousel',
                        touch: false
                    });
                }
            ");
        }
    }

    private async Task HandleSubmit()
    {
        _loading = true;
        _error = null;

        try
        {
            var student = await StudentService.LoginAsync(_creds.Matricula, _creds.Password);
            if (student is not null)
            {
                // Guardar sesión durante 10 minutos en sessionStorage
                await AuthService.SetSessionAsync(student, TimeSpan.FromMinutes(10));
                await OnSuccess.InvokeAsync(student);
            }
            else
            {
                _error = "Matrícula o contraseña incorrecta. Verifica tus credenciales.";
            }
        }
        catch
        {
            _error = "Error de conexión. Intenta de nuevo.";
        }
        finally
        {
            _loading = false;
        }
    }
}