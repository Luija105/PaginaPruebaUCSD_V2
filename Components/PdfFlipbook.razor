@inject IJSRuntime JSRuntime

<div id="@ContainerId" style="width:100%; box-sizing:border-box; min-height:200px;">
    <div class="fb-loading">
        <div class="fb-spinner"></div>
        <span>Preparando documento...</span>
    </div>
</div>

@code {
    [Parameter]
    public string PdfUrl { get; set; } = "";

    [Parameter]
    public string ContainerId { get; set; } = "pdf-flipbook-container";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(PdfUrl))
        {
            await JSRuntime.InvokeVoidAsync("renderPdfAsFlipbook", PdfUrl, ContainerId);
        }
    }
}