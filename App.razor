@using PaginaPruebaUCSD_V2.Models
@using PaginaPruebaUCSD_V2.Pages
@using PaginaPruebaUCSD_V2.Components

@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService
@inject NavigationManager Navigation

@if (!_initialized)
{
    <p>Loading...</p>
}
else if (AuthService.CurrentStudent is null)
{
    <LoginComponent OnSuccess="HandleLogin" />
}
else
{
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" />
        </Found>
        <NotFound>
            <p>Page not found.</p>
        </NotFound>
    </Router>
}

@code {
    private bool _initialized = false;

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
        await AuthService.RestoreSessionAsync();
        _initialized = true;
    }

    private void HandleLogin(Student student)
    {
        // after successful login, navigate to dashboard (or keep current route)
        Navigation.NavigateTo("/dashboard");
        StateHasChanged();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}
