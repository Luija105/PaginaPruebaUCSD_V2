@page "/seleccionasignaturas"
@layout MainLayout
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-procesos">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Selección de Asignaturas</h1>
            <p>Selecciona tus asignaturas para el próximo período.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">✅</div>
                <div class="info-card-title">Seleccionar asignaturas</div>
                <p class="info-card-body">Arma tu carga académica del próximo período.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Seleccionar</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">📚</div>
                <div class="info-card-title">Oferta académica</div>
                <p class="info-card-body">Consulta las asignaturas disponibles y sus horarios.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ver oferta</a></div>
            </div>
        </div>
    </main>
</div>
