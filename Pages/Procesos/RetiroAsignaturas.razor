@page "/retiroasignaturas"
@layout MainLayout
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-procesos">
    <Navigationbar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Retiro de Asignaturas</h1>
            <p>Procedimiento para retirar asignaturas del período.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">?</div>
                <div class="info-card-title">Retirar asignatura</div>
                <p class="info-card-body">Selecciona las asignaturas que deseas retirar.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Iniciar retiro</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">?</div>
                <div class="info-card-title">Plazos de retiro</div>
                <p class="info-card-body">Consulta las fechas límite para retiros.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ver plazos</a></div>
            </div>
        </div>
    </main>
</div>
