@page "/dashboard"
@layout MainLayout
@using PaginaPruebaUCSD_V2.Models
@using PaginaPruebaUCSD_V2.Services
@using PaginaPruebaUCSD_V2.Components
@inject IStudentService StudentService
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService
@inject NavigationManager Navigation

<div class="dashboard-shell">
    <NavBar StudentName="@CurrentStudent?.Nombre" OnLogout="HandleLogout" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Buenos días, @CurrentStudent?.Nombre 👋</h1>
            <p>@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-DO"))</p>
        </div>

        @if (_loading)
        {
            <div class="card-grid">
                <div class="skeleton-card" />
                <div class="skeleton-card" />
                <div class="skeleton-card" />
            </div>
        }
        else
        {
            if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="card-grid" style="margin-bottom: 1.25rem;">
                    <div class="card" style="padding: 1.25rem;">
                        <h3>Error cargando datos</h3>
                        <p class="alert-error">@_errorMessage</p>
                    </div>
                </div>
            }

            <!-- Fila Principal: Tarjetas Académicas -->
            <div class="card-grid">
                @if (CurrentStudent is not null)
                {
                    <StudentInfoCard Student="CurrentStudent" />
                }

                @if (_record is not null)
                {
                    <AcademicIndexCard Record="_record" />
                    <CreditsChart Record="_record" History="_history" />
                }
                else
                {
                    <div class="card" style="padding: 1.25rem;">
                        <h3>Sin registro académico</h3>
                        <p>No se encontró información académica para este estudiante.</p>
                    </div>
                }
            </div>

            <!-- Segunda Fila: Resumen Estadístico Arriba y Horario Abajo -->
            <div class="dashboard-secondary-grid" style="display: flex; flex-direction: column; gap: 1.25rem; margin-top: 1.25rem;">

                <!-- 1. Estadísticas Globales (Arriba a todo lo ancho) -->
                @if (_record is not null)
                {
                    <div class="stats-strip" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; width: 100%;">
                        <div class="stat-tile">
                            <span class="stat-label">Cuatrimestre actual</span>
                            <span class="stat-value navy">@_record.CuatrimestreActual°</span>
                        </div>
                        <div class="stat-tile">
                            <span class="stat-label">Índice cuatrimestral</span>
                            <span class="stat-value green">@_record.IndiceAcademico.ToString("F2")</span>
                        </div>
                        <div class="stat-tile">
                            <span class="stat-label">Créditos aprobados</span>
                            <span class="stat-value navy">@_record.CreditosAprobados</span>
                        </div>
                        <div class="stat-tile">
                            <span class="stat-label">Créditos restantes</span>
                            <span class="stat-value amber">@_record.CreditosRestantes</span>
                        </div>
                    </div>
                }

                <!-- 2. Widget de Horario (Abajo ocupando el ancho completo) -->
                <div class="grid-col-horario" style="width: 100%;">
                    <HorarioWidget />
                </div>

            </div>
        }
    </main>
</div>

@code {
    private AcademicRecord? _record;
    private List<CreditPeriod> _history = [];
    private bool _loading = true;
    private string? _errorMessage;

    private Student? CurrentStudent => AuthService.CurrentStudent;

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }

    protected override async Task OnInitializedAsync()
    {
        if (CurrentStudent is null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        var recordTask = StudentService.GetAcademicRecordAsync(CurrentStudent.Id);
        var historyTask = StudentService.GetCreditHistoryAsync(CurrentStudent.Id);
        try
        {
            await Task.WhenAll(recordTask, historyTask);
            _record = recordTask.Result;
            _history = historyTask.Result;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
} 