@page "/dashboard"
@using PaginaPruebaUCSD_V2.Models
@using PaginaPruebaUCSD_V2.Services
@using PaginaPruebaUCSD_V2.Components
@inject IStudentService StudentService
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService
@inject NavigationManager Navigation

<div class="dashboard-shell">
    <NavBar StudentName="@CurrentStudent?.Nombre" OnLogout="HandleLogout" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Buenos días, @CurrentStudent?.Nombre 👋</h1>
            <p>@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-DO"))</p>
        </div>

        @if (_loading)
        {
            <div class="card-grid">
                <div class="skeleton-card" />
                <div class="skeleton-card" />
                <div class="skeleton-card" />
            </div>
        }
        else if (_record is not null)
        {
            <div class="card-grid">
                <StudentInfoCard Student="CurrentStudent" />
                <AcademicIndexCard Record="_record" />
                <CreditsChart Record="_record" History="_history" />
            </div>

            <div class="stats-strip">
                <div class="stat-tile">
                    <span class="stat-label">Cuatrimestre actual</span>
                    <span class="stat-value navy">@_record.SemestreActual°</span>
                </div>
                <div class="stat-tile">
                    <span class="stat-label">Índice semestral</span>
                    <span class="stat-value green">@_record.IndiceAcademico.ToString("F2")</span>
                </div>
                <div class="stat-tile">
                    <span class="stat-label">Créditos aprobados</span>
                    <span class="stat-value navy">@_record.CreditosAprobados</span>
                </div>
                <div class="stat-tile">
                    <span class="stat-label">Créditos restantes</span>
                    <span class="stat-value amber">@_record.CreditosRestantes</span>
                </div>
            </div>
        }
    </main>
</div>

@code {
    private AcademicRecord? _record;
    private List<CreditPeriod> _history = [];
    private bool _loading = true;

    private Student? CurrentStudent => AuthService.CurrentStudent;

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }

    protected override async Task OnInitializedAsync()
    {
        if (CurrentStudent is null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        var recordTask  = StudentService.GetAcademicRecordAsync(CurrentStudent.Id);
        var historyTask = StudentService.GetCreditHistoryAsync(CurrentStudent.Id);
        await Task.WhenAll(recordTask, historyTask);
        _record  = recordTask.Result;
        _history = historyTask.Result;
        _loading = false;
    }
}
