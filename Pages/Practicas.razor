@page "/practicas"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-procesos">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Reajuste de selección</h1>
            <p>Procedimiento para solicitar cambios en la selección de asignaturas.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">🛠️</div>
                <div class="info-card-title">Cómo solicitar</div>
                <p class="info-card-body">Rellena el formulario y presenta la justificación académica.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Solicitar reajuste</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">⏳</div>
                <div class="info-card-title">Plazos</div>
                <p class="info-card-body">Consulta las fechas en el calendario académico.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ver plazos</a></div>
            </div>
        </div>
    </main>
</div>