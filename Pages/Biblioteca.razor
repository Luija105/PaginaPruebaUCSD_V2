@page "/biblioteca"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{
    var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante";
}

<div class="dashboard-shell page-servicios">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Biblioteca Virtual</h1>
            <p>Conéctate a recursos, bases de datos y material académico.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">🗄️</div>
                <div class="info-card-title">Bases de datos</div>
                <p class="info-card-body">Accede a JSTOR, Scopus y recursos suscritos por la universidad.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Explorar bases</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">🔎</div>
                <div class="info-card-title">Catálogo</div>
                <p class="info-card-body">Busca libros y material disponible en línea.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Buscar catálogo</a></div>
            </div>
        </div>
    </main>
</div>