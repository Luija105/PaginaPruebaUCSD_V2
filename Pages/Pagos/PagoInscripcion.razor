@page "/pagoinscripcion"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-pagos">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Pago de Inscripción</h1>
            <p>Realiza el pago de tu inscripción del período.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">🎟️</div>
                <div class="info-card-title">Pagar inscripción</div>
                <p class="info-card-body">Completa el pago de inscripción del período actual.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Pagar inscripción</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">🧾</div>
                <div class="info-card-title">Comprobante</div>
                <p class="info-card-body">Descarga el comprobante de tu pago de inscripción.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ver comprobante</a></div>
            </div>
        </div>
    </main>
</div>