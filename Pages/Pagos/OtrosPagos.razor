@page "/otrospagos"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-pagos">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Otros Pagos</h1>
            <p>Pagos adicionales: certificaciones, mora y servicios.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">💳</div>
                <div class="info-card-title">Realizar un pago</div>
                <p class="info-card-body">Paga servicios adicionales en línea.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Pagar ahora</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">📋</div>
                <div class="info-card-title">Conceptos de pago</div>
                <p class="info-card-body">Consulta los conceptos y montos disponibles.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ver conceptos</a></div>
            </div>
        </div>
    </main>
</div>