@page "/fechapago"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-pagos">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Fecha de Pagos</h1>
            <p>Calendario de fechas límite de pago del período.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">📆</div>
                <div class="info-card-title">Próximas fechas</div>
                <p class="info-card-body">Consulta las fechas límite de pago vigentes.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Ver fechas</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">🔔</div>
                <div class="info-card-title">Recordatorios</div>
                <p class="info-card-body">Activa notificaciones de fechas de pago.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Activar recordatorio</a></div>
            </div>
        </div>
    </main>
</div>