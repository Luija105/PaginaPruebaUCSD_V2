@page "/solicituddocumentos"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-solicitudes">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Solicitud de Documentos</h1>
            <p>Formularios y requisitos para solicitar certificados y otros documentos.</p>
        </div>

        <div class="card-grid">
            <div class="card">
                <h3>Nuevo trámite</h3>
                <p>Rellena el formulario y adjunta los documentos necesarios.</p>
            </div>

            <div class="card">
                <h3>Estado de solicitudes</h3>
                <p>Consulta el estado de tus solicitudes previas.</p>
            </div>
        </div>
    </main>
</div>
