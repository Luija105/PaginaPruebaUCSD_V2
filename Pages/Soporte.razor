@page "/soporte"
@layout MainLayout
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-servicios">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Soporte Técnico</h1>
            <p>Contacta al equipo de soporte para problemas con la plataforma.</p>
        </div>

        <div class="card-grid">
            <div class="card">
                <h3>Chat de soporte</h3>
                <p>Disponible de lunes a viernes, 8:00 - 17:00.</p>
            </div>

            <div class="card">
                <h3>Guías</h3>
                <p>Tutoriales para acceso, subida de tareas y configuración de cuentas.</p>
            </div>
        </div>
    </main>
</div>
