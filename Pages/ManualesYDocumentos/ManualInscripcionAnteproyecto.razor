@page "/manualinscripcionanteproyecto"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-manuales">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Manual de Inscripción — Tema de Anteproyecto</h1>
            <p>Pasos para inscribir el tema de tu anteproyecto.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">📝</div>
                <div class="info-card-title">Guía de inscripción</div>
                <p class="info-card-body">Sigue el paso a paso para inscribir tu tema.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Abrir manual</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">📎</div>
                <div class="info-card-title">Formato de anteproyecto</div>
                <p class="info-card-body">Descarga la plantilla oficial del anteproyecto.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Descargar plantilla</a></div>
            </div>
        </div>
    </main>
</div>