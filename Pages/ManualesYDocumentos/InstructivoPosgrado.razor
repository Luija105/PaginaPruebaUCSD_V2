@page "/instructivoposgrado"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-manuales">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Instructivo de Posgrado</h1>
            <p>Guía general para estudiantes de programas de posgrado.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">📘</div>
                <div class="info-card-title">Instructivo general</div>
                <p class="info-card-body">Procedimientos, requisitos y normativas de posgrado.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Abrir instructivo</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">❓</div>
                <div class="info-card-title">Preguntas frecuentes</div>
                <p class="info-card-body">Respuestas a las dudas más comunes de posgrado.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ver FAQ</a></div>
            </div>
        </div>
    </main>
</div>