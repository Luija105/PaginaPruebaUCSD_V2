@page "/instructivoposgrado"
@layout MainLayout
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{
    var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante";
}

<div class="dashboard-shell page-manuales">
    <Navigationbar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Instructivo de Posgrado</h1>
            <p>Guía general para estudiantes de programas de posgrado.</p>
        </div>

        <!-- Cabecera informativa separada del visor -->
        <div class="card-grid" style="margin-bottom:0.75rem;">
            <div class="info-card" style="grid-column: 1 / -1; flex-direction:row; align-items:center; gap:1rem; padding:1rem 1.25rem;">
                <div class="info-card-icon">📘</div>
                <div>
                    <div class="info-card-title">Instructivo general</div>
                    <p class="info-card-body" style="margin:0;">Navega con los botones o las flechas del teclado.</p>
                </div>
            </div>
        </div>

        <!-- Visor en su propio contenedor, sin padding extra -->
        <div style="
            background:#fff;
            border:1px solid #e2e8f0;
            border-left: 4px solid var(--gold);
            border-radius:1rem;
            padding:1rem;
            width:100%;
            box-sizing:border-box;
        ">
            <PdfFlipbook PdfUrl="sample-data/MANUAL_OPERATIVO_UCSD-POSGRADO.pdf"
                         ContainerId="flipbook-1" />
        </div>

    </main>
</div>