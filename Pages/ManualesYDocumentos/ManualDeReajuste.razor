@page "/manualdereajuste"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-manuales">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Manual de Reajuste</h1>
            <p>Normas y pasos para solicitar el reajuste de materias.</p>
        </div>

        <div class="card-grid">
            <div class="card">
                <h3>Requisitos</h3>
                <p>Documentos y plazos necesarios para tramitar un reajuste.</p>
            </div>

            <div class="card">
                <h3>Contactos</h3>
                <p>Consejería académica: consejeria@ucsd.edu.do</p>
            </div>
        </div>
    </main>
</div>
