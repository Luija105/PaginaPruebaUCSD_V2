@page "/manualdereajuste"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-manuales">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Manual de Reajuste</h1>
            <p>Instrucciones para el proceso de reajuste de selección.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">🔧</div>
                <div class="info-card-title">Cómo hacer el reajuste</div>
                <p class="info-card-body">Guía detallada del procedimiento de reajuste.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Abrir manual</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">📅</div>
                <div class="info-card-title">Fechas de reajuste</div>
                <p class="info-card-body">Consulta el calendario del proceso.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ver fechas</a></div>
            </div>
        </div>
    </main>
</div>