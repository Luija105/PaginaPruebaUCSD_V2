@page "/manualoperativovirtualidad"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-manuales">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Manual Operativo de Virtualidad</h1>
            <p>Guía de uso de las plataformas y aulas virtuales.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">💻</div>
                <div class="info-card-title">Uso del aula virtual</div>
                <p class="info-card-body">Aprende a navegar y usar la plataforma virtual.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Abrir manual</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">🛟</div>
                <div class="info-card-title">Soporte de virtualidad</div>
                <p class="info-card-body">Contacta soporte para temas de plataformas virtuales.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ir a soporte</a></div>
            </div>
        </div>
    </main>
</div>