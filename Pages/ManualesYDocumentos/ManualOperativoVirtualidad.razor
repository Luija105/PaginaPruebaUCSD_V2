@page "/manualoperativovirtualidad"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-manuales">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Manual Operativo de Virtualidad</h1>
            <p>Guía de uso de las plataformas y aulas virtuales.</p>
        </div>

        <div class="card-grid">
            <!-- Tarjeta extendida para ocupar todo el ancho del grid y albergar el lector -->
            <div class="info-card" style="grid-column: 1 / -1; width: 100%;">
                <div class="info-card-icon">📘</div>
                <p class="info-card-body">Haz clic o arrastra las esquinas de las páginas para pasar de hoja.</p>

                <!-- Contenedor del lector adaptado al grid -->
                <div class="mt-4" style="width: 100%; display: flex; justify-content: center; overflow: auto;">
                    <PdfFlipbook PdfUrl="sample-data\MANUAL_OPERATIVO_UCSD.pdf" />
                </div>
            </div>
        </div>
    </main>
</div>