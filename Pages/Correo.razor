@page "/correo"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{
    var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante";
}

<div class="dashboard-shell page-servicios">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Correo Institucional</h1>
            <p>Accede, configura y resuelve problemas con tu cuenta institucional.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">📧</div>
                <div class="info-card-title">Acceder al correo</div>
                <p class="info-card-body">Enlace: <a href="https://mail.ucsd.edu.do" target="_blank" rel="noopener">mail.ucsd.edu.do</a></p>
                <div class="info-card-actions"><a href="https://mail.ucsd.edu.do" target="_blank" rel="noopener" class="btn-inline solid">Ir al correo</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">🔐</div>
                <div class="info-card-title">Recuperación de contraseña</div>
                <p class="info-card-body">Usa el enlace de recuperación o contacta a soporte.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Recuperar acceso</a></div>
            </div>
        </div>
    </main>
</div>