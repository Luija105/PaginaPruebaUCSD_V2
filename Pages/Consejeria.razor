@page "/consejeria"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{
    var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante";
}

<div class="dashboard-shell page-procesos">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Actualizar Datos de Acceso</h1>
            <p>Procedimiento para actualizar tus credenciales y datos de acceso.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">🔑</div>
                <div class="info-card-title">Cambiar contraseña</div>
                <p class="info-card-body">Usa la opción de "Recuperar contraseña" o contacta soporte.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Cambiar contraseña</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">✉️</div>
                <div class="info-card-title">Actualizar correo</div>
                <p class="info-card-body">Enlaza tu correo institucional para notificaciones importantes.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Actualizar correo</a></div>
            </div>
        </div>
    </main>
</div>
