@page "/salud"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-procesos">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Adición de Asignaturas</h1>
            <p>Información sobre cómo adicionar materias y fechas límites.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">📋</div>
                <div class="info-card-title">Instrucciones</div>
                <p class="info-card-body">Revisa los requisitos y solicita la adición con tu consejero.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Ver instrucciones</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">➕</div>
                <div class="info-card-title">Lista de asignaturas</div>
                <p class="info-card-body">Selecciona las materias que deseas adicionar en el formulario.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Adicionar materias</a></div>
            </div>
        </div>
    </main>
</div>