@page "/carne"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{
    var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante";
}

<div class="dashboard-shell page-servicios">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Carné Estudiantil</h1>
            <p>Trámites para emisión y renovación del carné estudiantil.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">🪪</div>
                <div class="info-card-title">Estado del carné</div>
                <p class="info-card-body">Tu carné está activo y en buen estado.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Ver detalles</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">🔄</div>
                <div class="info-card-title">Renovación</div>
                <p class="info-card-body">Documentos necesarios: foto, cédula, formulario firmado.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Iniciar renovación</a></div>
            </div>
        </div>
    </main>
</div>