@page "/certificaciones"
@layout MainLayout
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{
    var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante";
}

<div class="dashboard-shell page-servicios">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Certificaciones</h1>
            <p>Solicita y descarga certificaciones académicas oficiales.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">📄</div>
                <div class="info-card-title">Solicitar certificación</div>
                <p class="info-card-body">Tiempo estimado: 3 días hábiles.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Solicitar</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">🗂️</div>
                <div class="info-card-title">Historial</div>
                <p class="info-card-body">Consulta certificaciones emitidas anteriormente.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ver historial</a></div>
            </div>
        </div>
    </main>
</div>
