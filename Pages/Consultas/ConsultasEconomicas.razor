@page "/consultaseconomicas"
@layout MainLayout
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-consultas">
    <Navigationbar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Consultas Económicas</h1>
            <p>Estado de cuenta, balances y movimientos financieros.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">💰</div>
                <div class="info-card-title">Estado de cuenta</div>
                <p class="info-card-body">Consulta tu balance actual y pagos pendientes.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Ver balance</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">🧾</div>
                <div class="info-card-title">Movimientos</div>
                <p class="info-card-body">Revisa el historial de pagos y cargos realizados.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ver movimientos</a></div>
            </div>
        </div>
    </main>
</div>
