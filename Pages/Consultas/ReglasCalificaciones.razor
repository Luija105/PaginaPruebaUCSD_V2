@page "/ReglasCalificaciones"
@layout MainLayout
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-consultas">
    <Navigationbar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Reglamento de Calificaciones</h1>
            <p>Normativa sobre el sistema de calificaciones y evaluación.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">📜</div>
                <div class="info-card-title">Escala de calificaciones</div>
                <p class="info-card-body">Consulta la escala y los criterios de aprobación vigentes.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Ver escala</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">⚖️</div>
                <div class="info-card-title">Reglamento completo</div>
                <p class="info-card-body">Descarga el documento oficial del reglamento.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Descargar reglamento</a></div>
            </div>
        </div>
    </main>
</div>
