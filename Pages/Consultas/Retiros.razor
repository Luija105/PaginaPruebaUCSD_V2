@page "/retiros"
@layout MainLayout
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-consultas">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Retiros</h1>
            <p>Procedimiento y efectos del retiro de asignaturas.</p>
        </div>

        <div class="card-grid">
            <div class="card">
                <h3>Cómo retirar</h3>
                <ol>
                    <li>Consulta calendario</li>
                    <li>Solicita formularios</li>
                    <li>Confirma con tu consejero</li>
                </ol>
            </div>

            <div class="card">
                <h3>Efectos</h3>
                <p>El retiro puede afectar tu avance y promedio; consulta con tu facultad.</p>
            </div>
        </div>
    </main>
</div>
