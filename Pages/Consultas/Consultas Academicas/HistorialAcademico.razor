@page "/historialacademico"
@layout MainLayout
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{
    var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante";
}

<div class="dashboard-shell page-consultas">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Historial Académico</h1>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-title">Historial académico</div>
                <p class="info-card-body">Revisa tu récord de notas por asignatura y período.</p>
            </div>
        </div>
    </main>
</div>
