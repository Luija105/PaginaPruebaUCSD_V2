@page "/consultasacademicas"
@layout MainLayout
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{
    var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante";
}

<div class="dashboard-shell page-consultas">
    <Navigationbar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Consultas Académicas</h1>
            <p>Revisa tu información académica: notas, historial y estatus.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">📊</div>
                <div class="info-card-title">Notas del período</div>
                <p class="info-card-body">Consulta las calificaciones del período académico actual.</p>
                <div class="info-card-actions"><NavLink href="/NotasPeriodo" class="btn-inline solid">Ver notas</NavLink></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">🎓</div>
                <div class="info-card-title">Historial académico</div>
                <p class="info-card-body">Revisa tu récord de notas por asignatura y período.</p>
                <div class="info-card-actions"><NavLink href="/historialacademico" class="btn-inline solid">Ver notas</NavLink></div>
            </div>
        </div>
    </main>
</div>
