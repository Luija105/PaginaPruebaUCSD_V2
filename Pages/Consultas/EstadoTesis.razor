@page "/EstadoTesis"
@layout MainLayout
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-consultas">
    <Navigationbar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Estado de Tesis</h1>
            <p>Seguimiento del estatus de tu trabajo de grado.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">📖</div>
                <div class="info-card-title">Estatus actual</div>
                <p class="info-card-body">Consulta la fase en la que se encuentra tu tesis.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Ver estatus</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">👤</div>
                <div class="info-card-title">Asesor asignado</div>
                <p class="info-card-body">Información de contacto de tu asesor de tesis.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ver asesor</a></div>
            </div>
        </div>
    </main>
</div>
