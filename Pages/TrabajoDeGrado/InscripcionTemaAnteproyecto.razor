@page "/inscripciontemaanteproyecto"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-trabajo">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Inscripción de Tema de Anteproyecto</h1>
            <p>Inscribe el tema de tu anteproyecto de grado.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">🧭</div>
                <div class="info-card-title">Inscribir tema</div>
                <p class="info-card-body">Registra el tema de tu anteproyecto para revisión.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Inscribir tema</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">📎</div>
                <div class="info-card-title">Requisitos</div>
                <p class="info-card-body">Consulta los requisitos y el formato requerido.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ver requisitos</a></div>
            </div>
        </div>
    </main>
</div>