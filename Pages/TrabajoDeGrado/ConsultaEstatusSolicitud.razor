@page "/consultaestatussolicitud"
@layout MainLayout
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-trabajo">
    <Navigationbar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Consulta de Estatus de Solicitud</h1>
            <p>Seguimiento del estatus de tus solicitudes de trabajo de grado.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">🔍</div>
                <div class="info-card-title">Estatus de solicitud</div>
                <p class="info-card-body">Consulta el estado de tus solicitudes activas.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Ver estatus</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">🗂️</div>
                <div class="info-card-title">Historial de solicitudes</div>
                <p class="info-card-body">Revisa las solicitudes que has realizado.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ver historial</a></div>
            </div>
        </div>
    </main>
</div>
