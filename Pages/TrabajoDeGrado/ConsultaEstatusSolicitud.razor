@page "/consultaestatussolicitud"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-trabajo">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Consulta de Estatus de Solicitud</h1>
            <p>Revisa el estado de tu solicitud de trabajo de grado y fechas asociadas.</p>
        </div>

        <div class="card-grid">
            <div class="card">
                <h3>Estado actual</h3>
                <p>En revisión por comité académico.</p>
            </div>
            y
            <div class="card">
                <h3>Plazos</h3>
                <p>Tiempo estimado de respuesta: 5-10 días hábiles.</p>
            </div>
        </div>
    </main>
</div>
