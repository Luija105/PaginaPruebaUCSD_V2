@page "/validarencuentros"
@using PaginaPruebaUCSD_V2.Components
@inject PaginaPruebaUCSD_V2.Services.IAuthService AuthService

@{ var studentName = AuthService.CurrentStudent?.Nombre ?? "Estudiante"; }

<div class="dashboard-shell page-trabajo">
    <NavBar StudentName="@studentName" />

    <main class="dashboard-main">
        <div class="page-header">
            <h1>Validar Encuentros</h1>
            <p>Registra y valida los encuentros con tu asesor.</p>
        </div>

        <div class="card-grid">
            <div class="info-card">
                <div class="info-card-icon">🤝</div>
                <div class="info-card-title">Registrar encuentro</div>
                <p class="info-card-body">Valida un encuentro realizado con tu asesor.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline solid">Registrar</a></div>
            </div>

            <div class="info-card">
                <div class="info-card-icon">📅</div>
                <div class="info-card-title">Encuentros validados</div>
                <p class="info-card-body">Consulta el historial de encuentros validados.</p>
                <div class="info-card-actions"><a href="#" class="btn-inline">Ver encuentros</a></div>
            </div>
        </div>
    </main>
</div>